rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function ehAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Chave geral: o admin liga/desliga novos testes em config/app (campo testeAberto)
    function testeAberto() {
      return !exists(/databases/$(database)/documents/config/app) ||
        get(/databases/$(database)/documents/config/app).data.get('testeAberto', true) == true;
    }

    // Um teste por aparelho: o documento só pode ser criado uma vez (id = código do terminal)
    match /testes/{id} {
      allow create: if logado() &&
        request.resource.data.keys().hasOnly(['uid','t']) &&
        request.resource.data.uid == request.auth.uid;
      allow read, delete: if ehAdmin();
      allow update: if false;
    }

    // Administradores: criados só pelo console do Firebase
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Licenças: cada cliente lê só a própria; o admin gerencia todas
    match /licencas/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      // Teste automático: o próprio usuário cria a licença, sempre de 6h, sem poder mudar isso depois
      allow create: if ehAdmin() || (
        logado() && request.auth.uid == uid && testeAberto() &&
        request.resource.data.keys().hasOnly(['nome','usuario','email','whatsapp','ativo','criadoEm','sessao','aparelho','aparelhoInfo','ultimoLogin','trocas','trocasTs','suspeito','teste','testeMs','expiraEm','autoTeste']) &&
        request.resource.data.ativo == true &&
        request.resource.data.teste == true &&
        request.resource.data.autoTeste == true &&
        request.resource.data.testeMs == 21600000 &&
        request.resource.data.nome is string && request.resource.data.nome.size() <= 60 &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.expiraEm is number &&
        request.resource.data.expiraEm >= request.time.toMillis() - 600000 &&
        request.resource.data.expiraEm <= request.time.toMillis() + 21600000 + 600000
      );
      allow delete: if ehAdmin();
      allow update: if ehAdmin() || (
        logado() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sessao','aparelho','aparelhoInfo','ultimoLogin','trocas','trocasTs','suspeito','visto'])
      ) || (
        // início do teste no 1º login: o cliente só define expiraEm, limitado ao tempo que o admin escolheu
        logado() && request.auth.uid == uid &&
        resource.data.get('teste', false) == true &&
        resource.data.get('expiraEm', null) == null &&
        resource.data.get('testeMs', 0) > 0 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sessao','aparelho','aparelhoInfo','ultimoLogin','trocas','trocasTs','suspeito','visto','expiraEm']) &&
        request.resource.data.expiraEm is number &&
        request.resource.data.expiraEm >= request.time.toMillis() - 600000 &&
        request.resource.data.expiraEm <= request.time.toMillis() + resource.data.testeMs + 600000
      );
    }

    // Cópia do cardápio de cada cliente: só o próprio dono lê e grava
    match /licencas/{uid}/dados/{d} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Configurações do app (suporte, versão e avisos): qualquer um lê, só o admin altera
    match /config/{doc} {
      allow read: if true;
      allow write: if ehAdmin();
    }
  }
}
